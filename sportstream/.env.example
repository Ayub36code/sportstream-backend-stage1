# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:19006

# ---- Database ----
DB_USER=sportstream
DB_PASSWORD=REPLACE_ME
DB_NAME=sportstream
DB_PORT=5432
DATABASE_URL=postgresql://sportstream:REPLACE_ME@localhost:5432/sportstream?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
JWT_REFRESH_TTL=30d

# ---- Video providers (mock/sandbox by default) ----
VIDEO_PROVIDER=mock
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ---- Payment providers (mock/sandbox by default) ----
PAYMENTS_MODE=sandbox
MTN_MOMO_API_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_SUBSCRIPTION_KEY=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Sports data providers ----
SPORTS_DATA_PROVIDER=mock
SPORTS_DATA_API_KEY=

# ---- Notifications ----
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FCM_SERVER_KEY=
